{
  "name": "@minsky-org/outbox",
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/stage.js",
  "types": "./dist/stage.d.ts",
  "exports": {
    ".": {
      "types": "./dist/stage.d.ts",
      "default": "./dist/stage.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "default": "./dist/table.js"
    },
    "./relay": {
      "types": "./dist/relay.d.ts",
      "default": "./dist/relay.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "default": "./dist/queue.js"
    },
    "./worker-host": {
      "types": "./dist/worker-host.d.ts",
      "default": "./dist/worker-host.js"
    },
    "./define-job": {
      "types": "./dist/define-job.d.ts",
      "default": "./dist/define-job.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "bullmq": "^5.79.0",
    "drizzle-orm": "^0.45.1",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "bullmq": "5.79.0",
    "drizzle-orm": "^0.45.1",
    "typescript": "^5.9.3",
    "valibot": "^1.3.1",
    "vitest": "^4.1.1"
  }
}
