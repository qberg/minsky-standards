{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  // No `extends` here on purpose: Biome honours `extends` only in the ROOT config, a
  // config that is itself extended never chains further, silently (proven 2026-09-07 on
  // Biome 2.5.8). Consumers list ultracite themselves, before this file. See README.
  "formatter": {
    // Stated here, not inherited: the org bar is spaces and 100 columns (handbook), and
    // it must hold even if a consumer forgets the ultracite entries.
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "trailingCommas": "es5" }
  },
  "css": {
    "formatter": { "lineWidth": 100 },
    // Tailwind v4 is org stack law, so @theme / @source / @apply must parse.
    "parser": { "tailwindDirectives": true }
  },
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // Load-bearing "**": a list whose FIRST entry starts with "!" makes Biome match no files.
    "includes": ["**", "!!dist", "!!node_modules", "!!generated", "!!pnpm-lock.yaml"]
  },
  "assist": {
    "actions": {
      "source": { "useSortedProperties": "off" }
    }
  },
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "error",
        "noNamespaceImport": "off"
      },
      "suspicious": { "noConsole": "warn" },
      "style": {
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" }
        }
      }
    }
  }
}
