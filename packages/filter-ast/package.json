{
  "name": "@minsky/filter-ast",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/ast.js",
  "types": "./dist/ast.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ast.d.ts",
      "default": "./dist/ast.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./calendar-date": {
      "types": "./dist/calendar-date.d.ts",
      "default": "./dist/calendar-date.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "default": "./dist/validate.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "default": "./dist/drizzle.js"
    },
    "./meili": {
      "types": "./dist/meili.d.ts",
      "default": "./dist/meili.js"
    },
    "./eval": {
      "types": "./dist/eval.d.ts",
      "default": "./dist/eval.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@minsky/result": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.1",
    "valibot": "^1.3.1"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "drizzle-orm": "^0.45.1",
    "meilisearch": "0.58.0",
    "postgres": "3.4.8",
    "typescript": "^5.9.3",
    "valibot": "^1.3.1",
    "vitest": "^4.1.1"
  }
}
