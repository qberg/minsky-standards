{
  "name": "@minsky/cache-aside",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/cache.js",
  "types": "./dist/cache.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cache.d.ts",
      "default": "./dist/cache.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "peerDependencies": {
    "ioredis": "^5.10.1",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ioredis": "5.10.1",
    "typescript": "^5.9.3",
    "valibot": "^1.3.1",
    "vitest": "^4.1.1"
  }
}
