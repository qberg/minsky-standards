{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/plugin-version-bump.sh\"",
            "timeout": 15,
            "statusMessage": "Checking plugin version bump"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/skills/ship-issue/scripts/guard.sh\"",
            "timeout": 5,
            "statusMessage": "Shared-branch guard: no stash, no add -A, no branches"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/comment-length.sh\"",
            "timeout": 15,
            "statusMessage": "Checking comment block length"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/wrap-nag.sh\"",
            "timeout": 15,
            "statusMessage": "Checking wrap ceremony stamp"
          }
        ]
      }
    ]
  }
}
